# ==============================================================================
# BlogHub Environment Configuration
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the active '.env' file to version control.
# ==============================================================================

# Security
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
# Options for DB_ENGINE: 'mysql' or 'sqlite'
# Default is 'mysql'. If MySQL is not yet installed/running on your machine,
# you may set DB_ENGINE=sqlite as a temporary development fallback.
DB_ENGINE=mysql
DB_NAME=bloghub_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Regional Settings
TIME_ZONE=Asia/Kolkata
